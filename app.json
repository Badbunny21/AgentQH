{
  "expo": {
    "name": "AgentHQ",
    "slug": "agenthq",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.agenthq.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "AgentHQ uses your photo library to set agent profile pictures.",
        "NSCameraUsageDescription": "AgentHQ uses your camera to capture agent profile pictures.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.agenthq.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#a3e635"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06070a",
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar"
    ],
    "scheme": "agenthq"
  }
}
